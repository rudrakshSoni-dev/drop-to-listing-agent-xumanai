# LLM Provider: "groq" (default) or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=
# Models: openai/gpt-oss-120b on Groq, with fallback to llama-3.3-70b-versatile
LLM_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile

# If using Gemini instead:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
LLM_THINKING_BUDGET=0 # 0 = thinking off (fastest); a token count; or "default"
LLM_CACHE=1           # cache responses in data/llm_cache so retries and eval reruns are free
TRANSCRIBE_BACKEND=whisper   # whisper (local, free) | gemini (uses a request per video)
WHISPER_MODEL=small.en
DEMO_DROPS_PER_IP=0   # new videos per visitor per day on a public demo; 0 = unlimited
MAX_VIDEO_SECONDS=180
CORS_ORIGINS=http://localhost:3000
# LLM_FIXTURE=tests/fixtures/llm_math_tutor.json  # offline mode: replay a recorded response (pair with TRANSCRIBE_BACKEND=gemini)
