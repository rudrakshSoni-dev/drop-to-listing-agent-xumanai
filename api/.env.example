GEMINI_API_KEY=
LLM_MODEL=            # set to a current Gemini model; never hardcoded in code
LLM_FALLBACK_MODEL=   # optional: tried when LLM_MODEL is overloaded (503/429)
LLM_THINKING_BUDGET=0 # 0 = thinking off (fastest); a token count; or "default"
TRANSCRIBE_BACKEND=gemini   # gemini | whisper
MAX_VIDEO_SECONDS=180
CORS_ORIGINS=http://localhost:3000
# LLM_FIXTURE=tests/fixtures/llm_math_tutor.json  # offline mode: replay a recorded response
